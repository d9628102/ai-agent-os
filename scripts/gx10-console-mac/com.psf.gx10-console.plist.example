<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.psf.gx10-console</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>-B</string><string>/Users/YOUR_USER/bin/console_pull.py</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GX10_CONSOLE_HOST</key><string>user@host</string>
    <key>PATH</key><string>/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/gx10-console.err</string>
</dict>
</plist>
