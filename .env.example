# ── Hermes Agent 環境變數範例 ──
# 複製成 .env 並填入實際值。
# 不要提交真正的 .env 進版本控制。

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres DSN（docker-compose 環境下 host = postgres）
HERMES_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/hermes_db

# 對外 API 驗證金鑰。留空則 development 環境不強制。
# production 環境若設定此值，所有 /query 請求須帶 X-API-Key header。
HERMES_API_KEY=

# LangGraph orchestrator 最大步數保護
HERMES_MAX_STEPS=8

# development | production
HERMES_ENV=development

# Rate limit: 每分鐘最大請求數
HERMES_RATE_LIMIT=30
