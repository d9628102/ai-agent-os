#!/usr/bin/env bash
# Installed via `git config core.hooksPath githooks` (see scripts/install_hooks.sh).
#
# Two independent checks per push, both able to block it:
#
# 1. scripts/code_review_agent.py --range -- blocking-level findings (syntax,
#    hardcoded secrets, injection risk, spec misalignment). A human can push
#    through anyway via `code_review_agent.py --override` (see that script's
#    docstring) -- these are heuristic judgments with room for "yes, this one
#    is fine".
#
# 2. pytest over TEST_TO_LOGIC's keys below -- pinned, previously-verified
#    behavior. THIS ONE HAS NO OVERRIDE. A failing test here means measured
#    behavior actually changed from a fact we already validated on real
#    GX10 runs, not a heuristic that might have a legitimate exception. If
#    the expected behavior really needs to change, the correct fix is to
#    edit the test's expectation as part of the same commit (so the diff
#    shows the deliberate change), not to push past a red test.
#
#    A new test file (from scripts/test_generation_agent.py or written by
#    hand) only gets this protection once it's added to TEST_TO_LOGIC below
#    -- that's a deliberate manual step, same principle as "a draft test
#    file is never trusted until a human reviews every assertion" carrying
#    through to "a reviewed file doesn't enforce anything until it's wired
#    in here on purpose".
#
# Also prints a (non-blocking) reminder if a push touches one of these test
# files without touching the .py file it's meant to test -- that shape is
# exactly what "quietly loosening a test instead of fixing the logic" looks
# like, so it's worth a human's eyes even though it isn't blocked outright.
#
# Known limitation: like any client-side git hook, this is skipped entirely
# by `git push --no-verify`. Closing that gap needs server-side enforcement
# (branch protection + a required CI check), which is a separate task.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
blocked=0

test_python="${repo_root}/.venv/bin/python"

# test file -> the .py file it's meant to test (for the test-only-change
# reminder). Add a new pair here only after a human has approved every
# assertion in the file -- see scripts/test_generation_agent.py's docstring.
declare -A TEST_TO_LOGIC=(
  ["tests/test_detect_think_reason.py"]="scripts/rag_answer.py"
  ["tests/test_report_helpers.py"]="scripts/generate_report.py"
  ["tests/test_numeric_consistency.py"]="scripts/numeric_consistency.py"
  ["tests/test_red_flag_detection.py"]="scripts/red_flag_detection.py"
  ["tests/test_crossdoc_helpers.py"]="scripts/rag_common.py"
  ["tests/test_scoring.py"]="scripts/scoring.py"
  ["tests/test_veto_check.py"]="scripts/veto_check.py"
)

run_pytest() {
  local range="$1"
  if ! git -C "${repo_root}" diff --name-only "${range}" | grep -q '\.py$'; then
    return 0  # nothing .py changed in this range, nothing to test
  fi
  if [ ! -x "${test_python}" ]; then
    echo "[test-gate] 找不到 ${test_python}，這個檢查沒有 override，" \
         "請先在 repo 根目錄跑 python3 -m venv .venv && .venv/bin/pip install pytest pytest-asyncio" >&2
    return 1
  fi
  local test_file full_paths=()
  for test_file in "${!TEST_TO_LOGIC[@]}"; do
    full_paths+=("${repo_root}/${test_file}")
  done
  echo "[test-gate] 跑 ${!TEST_TO_LOGIC[*]} ..." >&2
  if ! "${test_python}" -m pytest "${full_paths[@]}" -q; then
    echo "[test-gate] 測試失敗，這個不能 override，請修好邏輯或明確更新測試預期值後再推。" >&2
    return 1
  fi
  return 0
}

warn_test_only_change() {
  local range="$1"
  local changed
  changed="$(git -C "${repo_root}" diff --name-only "${range}")"
  local test_file logic_file
  for test_file in "${!TEST_TO_LOGIC[@]}"; do
    logic_file="${TEST_TO_LOGIC[$test_file]}"
    if echo "${changed}" | grep -q "^${test_file}$" \
        && ! echo "${changed}" | grep -q "^${logic_file}$"; then
      echo "[test-gate] 提醒：這次改了 ${test_file} 但沒有改 ${logic_file}。" \
           "如果是故意調整預期行為，麻煩在 commit message 裡講清楚為什麼；" \
           "如果不是故意的，這個形狀（只鬆動測試、沒改邏輯）正是規避測試的樣子，先確認一下。" >&2
    fi
  done
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue  # deleting the remote ref, nothing to review
  fi
  if [ "$remote_sha" = "$zero" ]; then
    echo "[code-review-gate] 新分支，沒有舊的 ref 可以比對，這次不自動審查" \
         "（需要時手動跑 code_review_agent.py --commit <sha>）。" >&2
    continue
  fi

  range="${remote_sha}..${local_sha}"

  echo "[code-review-gate] 審查 ${range} 裡的 .py 變更..." >&2
  if ! python3 "${repo_root}/scripts/code_review_agent.py" --range "${range}"; then
    blocked=1
  fi

  if ! run_pytest "${range}"; then
    blocked=1
  fi

  warn_test_only_change "${range}"
done

if [ "${blocked}" -ne 0 ]; then
  echo "[code-review-gate] push 被擋下，見上方報告。" >&2
  exit 1
fi

exit 0
