#!/usr/bin/env bash
# Installed via `git config core.hooksPath githooks` (see scripts/install_hooks.sh).
#
# Blocks a push when scripts/code_review_agent.py finds a blocking-level
# issue in the .py files being pushed, unless a human already ran
# `code_review_agent.py --override` for that exact set of findings (see the
# script's own docstring). This hook only decides "run the agent, respect
# its exit code" -- it never overrides anything itself.
#
# Known limitation: like any client-side git hook, this is skipped entirely
# by `git push --no-verify`. Closing that gap needs server-side enforcement
# (branch protection + a required CI check), which is a separate task.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue  # deleting the remote ref, nothing to review
  fi
  if [ "$remote_sha" = "$zero" ]; then
    echo "[code-review-gate] 新分支，沒有舊的 ref 可以比對，這次不自動審查" \
         "（需要時手動跑 code_review_agent.py --commit <sha>）。" >&2
    continue
  fi

  range="${remote_sha}..${local_sha}"
  echo "[code-review-gate] 審查 ${range} 裡的 .py 變更..." >&2
  if ! python3 "${repo_root}/scripts/code_review_agent.py" --range "${range}"; then
    blocked=1
  fi
done

if [ "${blocked}" -ne 0 ]; then
  echo "[code-review-gate] push 被擋下，見上方報告。" >&2
  exit 1
fi

exit 0
