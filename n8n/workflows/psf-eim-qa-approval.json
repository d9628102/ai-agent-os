    {
      "id": "f2a3b4c5-5555-4e5f-bf6a-7c8d9e0f1a2b",
      "name": "Build Decision Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "parameters": {
        "jsCode": "const q = $input.item.json.query || {};\nconst traceId = (q.traceId || '').trim();\nconst rawDecision = (q.decision || '').trim().toLowerCase();\nconst approver = (q.approver || 'psf01').trim();\nconst note = (q.note || '').trim();\n\nconst VALID = { approve: 'approved', reject: 'rejected' };\nconst decision = VALID[rawDecision];\n\nif (!traceId || !decision) {\n  return {\n    ok: false,\n    message: '參數錯誤：需要 traceId 跟 decision(approve 或 reject)，' +\n      `目前收到 traceId=\"${traceId}\" decision=\"${rawDecision}\"`,\n  };\n}\n\nconst decided_at = new Date().toISOString();\n\nconst hex = (len) => Array.from({ length: len }, () => Math.floor(Math.random() * 16).toString(16)).join('');\nconst uuid4 = () => `${hex(8)}-${hex(4)}-4${hex(3)}-a${hex(3)}-${hex(12)}`;\n\n// score-create 是 Langfuse 舊版 ingestion API 裡唯一保證長期支援的事件類型\n// (2026-11-16 後其餘事件類型會被拒絕，score-create 不受影響)，用它來留下\n// 一筆不可否認的核准/駁回紀錄：誰、什麼時候、決定是什麼。\nconst decision_body = {\n  batch: [\n    {\n      id: uuid4(),\n      timestamp: decided_at,\n      type: 'score-create',\n      body: {\n        id: uuid4(),\n        traceId,\n        name: 'human_decision',\n        value: decision,\n        dataType: 'CATEGORICAL',\n        // note 是自由文字，不送 Langfuse，只留在本機執行紀錄；Langfuse 只收決定、approver、時間。\n        comment: null,\n        metadata: { approver, decided_at, source: 'qa-approve-webhook' },\n      },\n    },\n  ],\n};\n\nreturn { ok: true, traceId, decision, approver, note, decided_at, decision_body };\n"
      }
    },
    {
      "id": "a3b4c5d6-6666-4f6a-8f7b-8d9e0f1a2b3c",
      "name": "Send Decision to Langfuse",
